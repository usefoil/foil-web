{
  "name": "foil-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static landing page and SEO content for Foil.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint . --cache --cache-location .eslintcache --max-warnings=0",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "lint:html": "html-validate \"index.html\" \"privacy/**/*.html\" \"blog/**/*.html\"",
    "format": "prettier --write package.json vercel.json \"*.config.mjs\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"styles/**/*.css\"",
    "format:check": "prettier --check package.json vercel.json \"*.config.mjs\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"styles/**/*.css\"",
    "knip": "knip --production",
    "check:size": "node scripts/check-file-size.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "check:blog": "node scripts/check-blog.mjs",
    "check:capture": "node scripts/check-capture.mjs",
    "check:deployed": "node scripts/check-deployed.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:interactions": "node scripts/check-site-interactions.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:launch": "npm run build && node scripts/check-launch.mjs && npm run check:seo && npm run check:interactions && npm run check:analytics && npm run check:blog && npm run check:capture && npm run check:install && npm run check:observability && npm run check:privacy",
    "check:release": "node scripts/check-release-drift.mjs",
    "quality": "npm run lint && npm run format:check && npm run knip && npm run check:size && npm run check:launch",
    "serve": "npm run build && python3 -m http.server 4173 -d dist"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "html-validate": "^11.5.6",
    "knip": "^6.26.0",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
